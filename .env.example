# Copy to .env and fill in your key. The OpenAI client reads OPENAI_BASE_URL and
# OPENAI_API_KEY straight from the environment. Never commit .env.
OPENAI_BASE_URL=https://llm.nat-d.uk/v1
OPENAI_API_KEY=sk-replace-me

CHAT_MODEL=gemma-4-E4B-it

# Where the ledger lives (SQLite). data/ is gitignored.
LEDGER_DB=data/ledger.db

# Your name(s) as they appear on slips, comma-separated. Used to decide whether a
# slip is money going OUT (you are the sender) or coming IN (you are the receiver).
# e.g. OWNER_NAMES=ชลัฐพล,CHALATPHON
OWNER_NAMES=

# The last digits of your own account number(s) as printed on slips (e.g. 226-0-xxx569
# -> 569), comma-separated. Checked before names: the model reads digits far more
# reliably than Thai names.
OWNER_ACCOUNTS=
